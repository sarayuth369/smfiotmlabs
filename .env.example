# SMF IoT — Environment Variables Template
# Copy this file to .env.local (never commit .env.local)
# Vercel: set the same keys in Settings → Environment Variables

# ============================================================
# Supabase (Required — auth + database)
# ============================================================
# Client-side safe:
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Server-only — BYPASSES RLS, never expose to client:
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ============================================================
# Stripe Payment (Required for paid plans / hardware orders)
# ============================================================
STRIPE_SECRET_KEY=sk_test_xxx_or_sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx_or_pk_live_xxx

# ============================================================
# PromptPay (Optional — Thai QR payment display)
# ============================================================
NEXT_PUBLIC_PROMPTPAY_ID=<thai-phone-or-national-id>
NEXT_PUBLIC_PROMPTPAY_NAME=M Labs Co Ltd

# ============================================================
# Admin Backend (Required — separate from Supabase Auth)
# ============================================================
# Random 64 hex — used to sign admin session cookies (HMAC-SHA256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=<random-64-hex>

# ============================================================
# Vercel Cron (Required — subscription lifecycle + analytics scan)
# ============================================================
# Random 64 hex — protects /api/cron/* from unauthorized invocation
CRON_SECRET=<random-64-hex>

# ============================================================
# Subscription (Optional — defaults if unset)
# ============================================================
# Grace period days before auto-downgrade to starter (default 7)
SUBSCRIPTION_GRACE_DAYS=7

# ============================================================
# MQTT + HiveMQ (Phase 9+ — required for telemetry pipeline)
# ============================================================
# Worker POSTs telemetry with HMAC-signed body using this secret
TELEMETRY_INGEST_SECRET=<random-64-hex>

# HiveMQ Cloud HTTP REST API (Starter tier only — Free tier: leave empty)
# Free tier: command publish will be deferred to MQTT worker
HIVEMQ_HTTP_API_URL=
HIVEMQ_HTTP_API_TOKEN=

# ============================================================
# LINE Messaging (Optional — broadcast + push notifications)
# ============================================================
LINE_CHANNEL_ACCESS_TOKEN=<line-official-account-token>

# ============================================================
# API Access + Webhooks (Phase 6.13 — Business/Premium)
# ============================================================
# 32 raw bytes, base64 — encrypts webhook secrets at rest (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRET_ENC_KEY=<base64-32-bytes>

# ============================================================
# AI Analysis (Phase 6.14 — Pro/Business/Premium)
# ============================================================
# Server-only — NEVER exposed to the browser/Flutter. Provider
# enable/disable + default provider + model name are admin-configurable
# at runtime (Admin > AI Analysis, stored non-secret in system_settings);
# these env vars are what makes each provider "Configured ✓" there.
#
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash-lite

# Prepared, not yet enabled by default (AI_ENABLE_OPENAI toggled in
# Admin > AI Analysis, not here) — leave empty until actually needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# NOT YET USED (Phase 11.2+)
# ============================================================
# ANTHROPIC_API_KEY=<sk-ant-xxx>       # never used for SMF — Claude API is banned from this system's runtime
# RESEND_API_KEY=<re_xxx>              # Custom SMTP for auth emails
# UPSTASH_REDIS_URL=<redis://...>      # Rate limiting
# UPSTASH_REDIS_TOKEN=<token>
